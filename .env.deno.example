# Deno Deploy Environment Variables Configuration
# Copy this file and configure your environment variables in Deno Deploy dashboard

# ============================================================================
# Configuration Method (Choose ONE)
# ============================================================================

# Method 1: Full YAML Configuration (Recommended)
# Paste your entire config.yaml content here
# CONFIG_YAML=|
#   host: "127.0.0.1"
#   port: 18080
#   api-keys:
#     - "your-api-key-here"
#   auth-dir: "/tmp/auths"
#   debug: false
#   logging-to-file: false

# Method 2: Config URL
# Provide a URL that returns your config.yaml content
# CONFIG_URL=https://example.com/config.yaml

# Method 3: Minimal Configuration (Auto-generated)
# If neither CONFIG_YAML nor CONFIG_URL is set, a minimal config will be generated
# You only need to provide API keys

# ============================================================================
# API Keys (Required if using Method 3)
# ============================================================================

# Multiple API keys (comma or newline separated)
# API_KEYS=key1,key2,key3

# Or single API key
# API_KEY=your-api-key-here

# ============================================================================
# Management API (Optional)
# ============================================================================

# Management API secret key for remote management
# MGMT_KEY=your-management-key-here

# ============================================================================
# Advanced Configuration (Optional)
# ============================================================================

# Backend port (default: 18080)
# CLI_PROXY_BACKEND_PORT=18080

# Custom binary path (default: auto-detected based on OS/arch)
# CLI_PROXY_BINARY_PATH=./deno/bin/cli-proxy-api-plus_linux_amd64

# ============================================================================
# Example: Minimal Setup
# ============================================================================
# API_KEYS=my-secret-api-key-123
# MGMT_KEY=my-management-key-456

# ============================================================================
# Example: Full Configuration
# ============================================================================
# CONFIG_YAML=|
#   host: "127.0.0.1"
#   port: 18080
#   remote-management:
#     allow-remote: true
#     secret-key: "your-management-key"
#     disable-control-panel: false
#   auth-dir: "/tmp/auths"
#   api-keys:
#     - "your-api-key-1"
#     - "your-api-key-2"
#   debug: false
#   logging-to-file: false
#   gemini-api-key:
#     - api-key: "AIzaSy...01"
#       prefix: "gemini"
#   claude-api-key:
#     - api-key: "sk-ant-..."
#       prefix: "claude"
